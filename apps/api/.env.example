ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://hring:hring@postgres:5432/hring
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=hring-private
OBJECT_STORAGE_ACCESS_KEY=hring
OBJECT_STORAGE_SECRET_KEY=change-me
AI_BASE_URL=http://ai:8000/v1
AI_API_KEY=local-development
CORS_ORIGINS=["http://localhost:5173"]
AUTH_JWT_SECRET=development-only-change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=hring
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SECURITY_TOKEN_PEPPER=development-security-token-pepper-change-me
AUTH_MFA_ENCRYPTION_KEY=development-mfa-encryption-key-change-me
AUTH_MFA_ISSUER=HRing
AUTH_MFA_RECOVERY_CODE_COUNT=10
AUTH_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_LOGIN_ATTEMPT_RETENTION_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_EMAIL_VERIFY_TTL_HOURS=24
SMS_PROVIDER=disabled
SMS_OTP_PEPPER=development-sms-otp-pepper-change-me
SMS_OTP_TTL_SECONDS=120
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_MFA_PER_MINUTE=10
EMAIL_PROVIDER=disabled
# For production email delivery:
# EMAIL_PROVIDER=resend
# EMAIL_RESEND_API_KEY=set-in-secret-manager
# EMAIL_FROM=HRing <noreply@your-domain.example>
PAYMENT_PROVIDER=disabled
PAYMENT_CALLBACK_PATH=/upgrade
# Optional dedicated Fernet key; when empty, a domain-separated key is derived from AUTH_SECURITY_TOKEN_PEPPER.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_ENCRYPTION_KEY=
INTEGRATION_INTERNAL_HOSTS=["ai","ollama","vllm"]
# For production Zarinpal payments:
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=set-in-secret-manager
