# Copy to .env.standalone, replace every CHANGE_ME value, then run:
# docker compose --env-file .env.standalone up -d --build

PUBLIC_APP_URL=https://hring.ir
WEB_PORT=8080
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
WORKER_CONCURRENCY=2
WORKER_MAX_TASKS_PER_CHILD=100
WORKER_MAX_MEMORY_PER_CHILD_KB=262144

POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
MINIO_ROOT_USER=hring
MINIO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_MINIO_PASSWORD

AUTH_JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
AUTH_SECURITY_TOKEN_PEPPER=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS
AUTH_LOGIN_LOCKOUT_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
SMS_OTP_PEPPER=CHANGE_ME_64_PLUS_RANDOM_CHARACTERS

# Optional but recommended: an independent Fernet key for provider secrets.
# Generate once and keep it stable: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_SECRET_ENCRYPTION_KEY=
INTEGRATION_INTERNAL_HOSTS=["ai","ollama","vllm"]

# One private service-to-service secret between HRing API and the HRing AI Gateway.
# This is NOT an upstream provider key and is never exposed to the browser.
AI_API_KEY=CHANGE_ME_64_PLUS_RANDOM_INTERNAL_GATEWAY_SECRET

# Upstream provider credentials belong only to the private AI Gateway.
# Configure only the providers you intend to enable.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Provider base URLs are fixed server-side aliases; ordinary feature requests cannot supply URLs.
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PERPLEXITY_BASE_URL=https://api.perplexity.ai

# Optional local AI runtime. Nothing starts or downloads unless its Compose profile is enabled.
OLLAMA_IMAGE=ollama/ollama:0.32.15
OLLAMA_MODEL=
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=32

# Optional GPU-only vLLM override. Set these directly on the server before including compose.vllm.yaml.
VLLM_IMAGE=vllm/vllm-openai:v0.20.1
VLLM_MODEL=
VLLM_API_KEY=
HF_TOKEN=

# Smart Headhunting model routing. These can change without editing feature code.
RECRUITING_AI_PROVIDER=gemini
RECRUITING_AI_MODEL=gemini-2.5-pro
RECRUITING_ENRICHMENT_PROVIDER=perplexity
RECRUITING_ENRICHMENT_MODEL=sonar

# Real Make/PhantomBuster-compatible sourcing webhook. Leave blank to fail closed.
RECRUITING_SOURCING_WEBHOOK_URL=
RECRUITING_SOURCING_WEBHOOK_BEARER_TOKEN=

# Keep disabled until real provider drivers are configured.
SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
EMAIL_RESEND_API_KEY=
EMAIL_FROM=HRing <noreply@hring.ir>
PAYMENT_PROVIDER=disabled
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_PATH=/upgrade

CORS_ORIGINS=["https://hring.ir","https://www.hring.ir"]
TRUSTED_HOSTS=["hring.ir","www.hring.ir","localhost","127.0.0.1","api"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MFA_PER_MINUTE=10

# One-time super admin bootstrap. Do NOT leave these in shell history or source control.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_14_CHARACTERS
BOOTSTRAP_ADMIN_NAME=HRing Super Admin
